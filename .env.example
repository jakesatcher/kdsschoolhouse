NODE_ENV=production
# Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:pass@host:5432/railway
# Long random string (openssl rand -base64 48). Changing it signs everyone out.
SESSION_SECRET=
APP_NAME=KDS Schoolhouse
# First admin, created on first boot if the email does not exist yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-passphrase-here
ADMIN_NAME=Admin
# Set true only if your Postgres requires SSL (Railway private network does not).
DATABASE_SSL=false

# --- AI worksheet generation (Reading: passages, vocabulary, questions) ---
# Get a key at https://console.anthropic.com. Without it, teachers can still write their own passages and questions.
ANTHROPIC_API_KEY=
# Optional overrides
AI_MODEL=claude-opus-5-5
# Max AI generations per teacher per hour
AI_HOURLY_LIMIT=30
