<% seg.forEach(function (s) { if (typeof s === 'string') { %><%= s %><% } else if (s.f) { %><%- include('../learn/_frac', { o: { w: 0, n: s.f[0], d: s.f[1] } }) %><% } else if (s.m) { %><%- include('../learn/_frac', { o: { w: s.m[0], n: s.m[1], d: s.m[2] } }) %><% } else if (s.sup) { %><sup><%= s.sup %></sup><% } else if (s.sp) { %><i class="blank short"></i><% } else if (s.b) { %><strong><%= s.b %></strong><% } }) %>
