<% const f = (n) => (typeof n === 'string' ? n : Number(n).toLocaleString('en-US')); %>
<% if (p.fr) { %>
  <% if (layout === 'vertical') { %>
  <div class="vp fvp">
    <% p.operands.forEach(function (o, k) { %><div class="row"><span class="opsym"><%= k === p.operands.length - 1 ? p.op : '' %></span><%- include('_frac', { o }) %></div><% }) %>
    <div class="rule w1"></div>
  </div>
  <% } else { %>
  <div class="hp fhp"><%- include('_frac', { o: p.operands[0] }) %> <%= p.op %> <%- include('_frac', { o: p.operands[1] }) %> = <i class="blank short"></i></div>
  <% } %>
<% } else if (p.op === '÷' && layout === 'vertical') { %>
  <div class="div-bracket w<%= p.work || 0 %>"><span class="divisor"><%= f(p.operands[1]) %></span><span class="dividend"><%= f(p.operands[0]) %></span></div>
<% } else if (layout === 'vertical') { %>
  <div class="vp">
    <% p.operands.forEach(function (n, k) { %><div class="row"><span class="opsym"><%= k === p.operands.length - 1 ? p.op : '' %></span><span class="n"><%= f(n) %><% if (p.pads && p.pads[k]) { %><span class="pad"><%= '0'.repeat(p.pads[k]) %></span><% } %></span></div><% }) %>
    <div class="rule w<%= p.work || 0 %>"></div>
  </div>
<% } else { %>
  <div class="hp"><%= p.operands.map(f).join(' ' + p.op + ' ') %> = <i class="blank short"></i></div>
<% } %>
