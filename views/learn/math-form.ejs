<%- include('../partials/head') %>
<h1>Math</h1>
<div class="card">
  <form method="get" action="/math/<%= type %>/worksheet" class="settings">
    <label>Problem type
      <select data-nav>
        <% Object.keys(types).forEach(function (k) { %><option value="/math/<%= k %>" <%= k === type ? 'selected' : '' %>><%= types[k] %></option><% }) %>
      </select>
    </label>
    <noscript><p class="muted">Use the Math menu at the top to switch problem type.</p></noscript>
    <%- include('../partials/errors', { errors: [] }) %>

    <% if (type === 'addition' || type === 'subtraction') { %>
      <label>Number of digits <select name="digits"><% for (let d = 2; d <= 7; d++) { %><option value="<%= d %>" <%= String(q.digits || 2) === String(d) ? 'selected' : '' %>><%= d %> digits</option><% } %></select></label>
      <label>Regrouping <select name="regroup"><option value="always">Every problem needs regrouping</option><option value="any" <%= q.regroup === 'any' ? 'selected' : '' %>>Any (regrouping not guaranteed)</option></select></label>
      <% if (type === 'addition') { %><label>Addends <select name="addends"><option value="2">2 numbers</option><option value="3" <%= q.addends === '3' ? 'selected' : '' %>>3 numbers</option></select></label><% } %>
      <label>Problems <select name="count"><% [10, 20, 30, 40, 50].forEach(function (n) { %><option <%= String(q.count || 20) === String(n) ? 'selected' : '' %>><%= n %></option><% }) %></select></label>
      <label>Layout <select name="layout"><option value="vertical">Vertical (stacked)</option><option value="horizontal" <%= q.layout === 'horizontal' ? 'selected' : '' %>>Horizontal</option></select></label>
    <% } else if (type === 'multiplication' || type === 'division') { %>
      <% const sel = function (name, dflt) { return q[name] || dflt; }; %>
      <label>Problem set
        <select name="mode">
          <option value="facts" <%= sel('mode', 'facts') === 'facts' ? 'selected' : '' %>>Facts, 0 to 12</option>
          <option value="multi" <%= q.mode === 'multi' ? 'selected' : '' %>>Multi-digit (you choose the sizes)</option>
          <option value="mixed" <%= q.mode === 'mixed' ? 'selected' : '' %>>Mixed (facts plus multi-digit)</option>
        </select>
      </label>
      <% if (type === 'multiplication') { %>
        <label data-show-if="mode:facts">Factor <select name="factor"><option value="all">All facts (mixed problems)</option><% for (let f = 0; f <= 12; f++) { %><option value="<%= f %>" <%= q.factor === String(f) ? 'selected' : '' %>>Facts for <%= f %></option><% } %></select></label>
        <div data-show-if="mode:multi">
          <label>Top number <select name="top"><% [['1', '1 digit'], ['2', '2 digits'], ['3', '3 digits'], ['4', '4 digits'], ['mixed', 'Mix of 1 to 4 digits']].forEach(function (o) { %><option value="<%= o[0] %>" <%= sel('top', '3') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></label>
          <label>Bottom number (multiplier) <select name="bottom"><% [['1', '1 digit'], ['2', '2 digits'], ['mixed', 'Mix of 1 and 2 digits']].forEach(function (o) { %><option value="<%= o[0] %>" <%= sel('bottom', '1') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></label>
        </div>
      <% } else { %>
        <label data-show-if="mode:facts">Divisor <small class="muted">(no division by 0)</small> <select name="divisor"><option value="all">All facts (mixed problems)</option><% for (let f = 1; f <= 12; f++) { %><option value="<%= f %>" <%= q.divisor === String(f) ? 'selected' : '' %>>Divide by <%= f %></option><% } %></select></label>
        <div data-show-if="mode:multi">
          <label>Dividend (the number being divided) <select name="dividend"><% [['2', '2 digits'], ['3', '3 digits'], ['4', '4 digits'], ['mixed', 'Mix of 2 to 4 digits']].forEach(function (o) { %><option value="<%= o[0] %>" <%= sel('dividend', '3') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></label>
          <label>Divisor <select name="vdigits"><% [['1', '1 digit'], ['2', '2 digits'], ['mixed', 'Mix of 1 and 2 digits']].forEach(function (o) { %><option value="<%= o[0] %>" <%= sel('vdigits', '1') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></label>
          <label>Remainders <select name="remainders"><% [['none', 'No remainders (divides evenly)'], ['with', 'All with remainders'], ['mixed', 'A mix of both']].forEach(function (o) { %><option value="<%= o[0] %>" <%= sel('remainders', 'mixed') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></label>
        </div>
      <% } %>
      <label>Problems <select name="count"><% [6, 8, 12, 16, 20, 30, 40, 50, 60].forEach(function (n) { %><option <%= String(q.count || (q.mode === 'multi' ? 12 : 30)) === String(n) ? 'selected' : '' %>><%= n %></option><% }) %></select></label>
      <label class="check"><input type="hidden" name="special" value="0"><input type="checkbox" name="special" value="1" <%= q.special === undefined || q.special === '1' || (Array.isArray(q.special) && q.special[q.special.length - 1] === '1') ? 'checked' : '' %>> <%= type === 'multiplication' ? 'Include multiplying by 0 and 1' : 'Include dividing by 1 and 10' %></label>
      <p class="muted small-text">Multi-digit problems leave extra work space under each one, so use fewer problems per page (about 12 to 20) for long division.</p>
      <label>Layout <select name="layout"><option value="vertical"><%= type === 'division' ? 'Long-division bracket' : 'Vertical (stacked)' %></option><option value="horizontal" <%= q.layout === 'horizontal' ? 'selected' : '' %>>Horizontal</option></select></label>
    <% } else if (type === 'decimals') { %>
      <% const opts = function (name, list, dflt) { return list.map(function (o) { return '<option value="' + o[0] + '"' + ((q[name] || dflt) === o[0] ? ' selected' : '') + '>' + o[1] + '</option>'; }).join(''); }; %>
      <label>Operation <select name="op"><%- opts('op', [['add', 'Addition'], ['sub', 'Subtraction'], ['mul', 'Multiplication'], ['div', 'Division']], 'add') %></select></label>
      <label>Decimal places <select name="places"><%- opts('places', [['1', 'Tenths (1 place)'], ['2', 'Hundredths (2 places)'], ['3', 'Thousandths (3 places)'], ['mixed', 'Mixed: 1 to 3 places in a problem']], '2') %></select></label>
      <label>Whole-number digits (before the point) <select name="digits"><%- opts('digits', [['1', '1 digit'], ['2', '2 digits'], ['3', '3 digits'], ['4', '4 digits (thousands)']], (q.op === 'mul' || q.op === 'div') ? '1' : '2') %></select></label>
      <label data-show-if="op:add">Addends <select name="addends"><%- opts('addends', [['2', '2 numbers'], ['3', '3 numbers']], '2') %></select></label>
      <label>Second number <small class="muted">(multiplying and dividing only)</small> <select name="second"><%- opts('second', [['whole', 'Whole number'], ['decimal', 'Decimal'], ['mixed', 'A mix of both']], 'whole') %></select></label>
      <label>Problems <select name="count"><% [10, 15, 20, 25, 30, 40, 50].forEach(function (n) { %><option <%= String(q.count || 20) === String(n) ? 'selected' : '' %>><%= n %></option><% }) %></select></label>
      <label>Layout <select name="layout"><%- opts('layout', [['vertical', 'Vertical (stacked, points lined up)'], ['horizontal', 'Horizontal']], 'vertical') %></select></label>
      <p class="muted small-text">Division problems always come out evenly (no repeating decimals). Using a decimal divisor means moving the point first.</p>
    <% } else if (type === 'fractions') { %>
      <% const opts = function (name, list, dflt) { return list.map(function (o) { return '<option value="' + o[0] + '"' + ((q[name] || dflt) === o[0] ? ' selected' : '') + '>' + o[1] + '</option>'; }).join(''); }; %>
      <label>Operation <select name="op"><%- opts('op', [['add', 'Addition'], ['sub', 'Subtraction'], ['mul', 'Multiplication'], ['div', 'Division']], 'add') %></select></label>
      <label>Denominators <select name="den"><%- opts('den', [['like', 'Like (same) denominators'], ['unlike', 'Unlike (different) denominators'], ['mixed', 'A mix of like and unlike']], 'unlike') %></select></label>
      <label>Numbers <select name="form"><%- opts('form', [['proper', 'Fractions'], ['mixed', 'Mixed numbers'], ['mix', 'Fractions, mixed numbers and (for × and ÷) whole numbers']], 'proper') %></select></label>
      <label>Largest denominator <select name="maxden"><%- opts('maxden', [['4', '4'], ['6', '6'], ['8', '8'], ['10', '10'], ['12', '12'], ['15', '15'], ['20', '20']], '8') %></select></label>
      <label>Problems <select name="count"><% [10, 15, 20, 25, 30, 40, 50].forEach(function (n) { %><option <%= String(q.count || 20) === String(n) ? 'selected' : '' %>><%= n %></option><% }) %></select></label>
      <label>Layout <small class="muted">(× and ÷ are always across)</small> <select name="layout"><%- opts('layout', [['vertical', 'Vertical (stacked)'], ['horizontal', 'Horizontal']], 'vertical') %></select></label>
      <p class="muted small-text">Answers are in simplest form (improper results shown as mixed numbers). Multiplication and division are always written across the page.</p>
    <% } else { %>
      <label>Grade level <select name="grade"><% grades.forEach(function (g) { %><option value="<%= g %>" <%= String(q.grade || 3) === String(g) ? 'selected' : '' %>>Grade <%= g %></option><% }) %></select></label>
      <label>Operation <select name="op"><% ops.forEach(function (o) { %><option value="<%= o %>" <%= q.op === o ? 'selected' : '' %>><%= { add: 'Addition', sub: 'Subtraction', mul: 'Multiplication', div: 'Division', mixed: 'All operations (mixed)' }[o] %></option><% }) %></select></label>
      <label>Numbers <select name="kind"><% kinds.forEach(function (k) { %><option value="<%= k %>" <%= (q.kind || 'whole') === k ? 'selected' : '' %>><%= { whole: 'Whole numbers', decimal: 'Decimals (money and measurement)', fraction: 'Fractions', mixed: 'All number types (mixed)' }[k] %></option><% }) %></select></label>
      <label>Difficulty <select name="level"><% [['mixed', 'Mixed: standard and challenge problems'], ['standard', 'Standard'], ['challenge', 'Challenge (harder, more steps)']].forEach(function (o) { %><option value="<%= o[0] %>" <%= (q.level || 'mixed') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></label>
      <label>Steps <select name="steps"><% steps.forEach(function (s) { %><option value="<%= s %>" <%= (q.steps || 'mixed') === s ? 'selected' : '' %>><%= { single: 'One step', multi: 'Multi-step only', mixed: 'Mix of one-step and multi-step' }[s] %></option><% }) %></select></label>
      <label>Problems <select name="count"><% [5, 8, 10, 12, 15].forEach(function (n) { %><option <%= String(q.count || 10) === String(n) ? 'selected' : '' %>><%= n %></option><% }) %></select></label>
    <% } %>
    <label class="check"><input type="hidden" name="key" value="0"><input type="checkbox" name="key" value="1" checked> Include answer key on a separate page</label>
    <button type="submit">Create worksheet</button>
  </form>
</div>
<p class="muted small-text"><%= (guide[q.grade] || '') %></p>
<details class="muted small-text"><summary>SC grade-level guide</summary><ul><% Object.keys(guide).forEach(function (g) { %><li><%= guide[g] %></li><% }) %></ul><p>Planning hints only. Confirm against the SC College- and Career-Ready Standards.</p></details>
<%- include('../partials/foot') %>
