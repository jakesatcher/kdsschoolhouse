<%- include('../partials/head') %>
<section class="card narrow">
  <h1>Request access</h1>
  <%- include('../partials/errors') %>
  <form method="post" action="/register" autocomplete="on">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Name <input name="name" value="<%= values.name || '' %>" required maxlength="100" autocomplete="name"></label>
    <label>Username <small class="muted">(3 to 40 letters, numbers, . _ - @)</small> <input name="username" value="<%= values.username || '' %>" required minlength="3" maxlength="40" autocomplete="username" autocapitalize="none" spellcheck="false"></label>
    <label>Password <small class="muted">(at least 12 characters)</small> <input type="password" name="password" required minlength="12" maxlength="72" autocomplete="new-password" data-reveal></label>
    <label class="check"><input type="checkbox" data-reveal-toggle> Show password</label>
    <button type="submit">Request access</button>
  </form>
  <p class="muted"><a href="/login">Back to sign in</a></p>
</section>
<%- include('../partials/foot') %>
