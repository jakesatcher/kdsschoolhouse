<%- include('../partials/head') %>
<section class="card narrow">
  <h1>Change password</h1>
  <% if (forced) { %><div class="alert err">You must choose a new password before continuing.</div><% } %>
  <%- include('../partials/errors') %>
  <form method="post" action="/account/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Current password <input type="password" name="current_password" required autocomplete="current-password" maxlength="200"></label>
    <label>New password <small class="muted">(at least 12 characters)</small> <input type="password" name="new_password" required minlength="12" maxlength="72" autocomplete="new-password"></label>
    <label>Confirm new password <input type="password" name="new_password2" required minlength="12" maxlength="72" autocomplete="new-password"></label>
    <button type="submit">Update password</button>
  </form>
</section>
<%- include('../partials/foot') %>
